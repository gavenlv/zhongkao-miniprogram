.container {
  padding: 20rpx;
  padding-bottom: 60rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.year-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.year-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
}

.year-tab.active {
  background: #1890ff;
  color: #fff;
  font-weight: bold;
}

.year-summary {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #f0f0f0;
}

.summary-item:last-child {
  border-right: none;
}

.summary-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 88rpx;
  padding: 0;
  background: transparent;
  font-size: 28rpx;
  line-height: 88rpx;
  color: #262626;
  box-sizing: border-box;
}

.search-placeholder {
  color: #bfbfbf;
  font-size: 28rpx;
}

.list-tip {
  font-size: 24rpx;
  color: #8c8c8c;
  padding: 0 8rpx 16rpx;
}

.junior-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.junior-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.junior-item:last-child {
  border-bottom: none;
}

.junior-item:active {
  background: #fafafa;
}

.junior-main {
  flex: 1;
  min-width: 0;
}

.junior-name {
  font-size: 30rpx;
  color: #262626;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.junior-meta {
  font-size: 24rpx;
  color: #8c8c8c;
}

.junior-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #bfbfbf;
  border-right: 3rpx solid #bfbfbf;
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.detail-head {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.back-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #1890ff;
  margin-bottom: 16rpx;
}

.detail-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 10rpx;
}

.detail-sub {
  font-size: 24rpx;
  color: #8c8c8c;
}

.detail-match {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #1890ff;
}

.candidate-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.candidate-title {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 16rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.candidate-item {
  padding: 20rpx 24rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #262626;
}

.candidate-item:active {
  background: #e6f7ff;
  color: #1890ff;
}

.detail-stats {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #f0f0f0;
}

.stat:last-child {
  border-right: none;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #595959;
}

.record-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.record {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record:last-child {
  border-bottom: none;
}

.record.empty-record {
  background: #fafafa;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.record-school {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #262626;
  padding-right: 16rpx;
}

.record-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
  flex-shrink: 0;
}

.record-status {
  font-size: 26rpx;
  color: #bfbfbf;
  flex-shrink: 0;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.record-meta.muted {
  color: #bfbfbf;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 26rpx;
}

.note-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #faad14;
}

.note-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #d48806;
  margin-bottom: 12rpx;
}

.note-text {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.6;
  margin-bottom: 6rpx;
}
