<view class="page">
  <view class="head">
    <view class="head-sub">{{subjectName}} · 学习模块</view>
    <view class="head-title">{{moduleName}}</view>
    <view class="head-meta">
      <text>共 {{total}} 个知识点</text>
      <text class="dot">·</text>
      <text>按年级筛选，点击开始学习</text>
    </view>
  </view>

  <view class="toolbar">
    <view class="search">
      <view class="search-icon"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索标题、作者或标签"
        confirm-type="search"
        bindinput="onInput"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClear">×</view>
    </view>
    <scroll-view wx:if="{{grades.length > 1}}" class="grade-scroll" scroll-x enable-flex>
      <view class="grade-chip {{grade === 'all' ? 'on' : ''}}" bindtap="onGrade" data-id="all">全部</view>
      <view
        wx:for="{{grades}}"
        wx:key="id"
        class="grade-chip {{grade === item.id ? 'on' : ''}}"
        bindtap="onGrade"
        data-id="{{item.id}}"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-title">没有找到相关内容</view>
    <view class="empty-desc">换个关键词或年级试试</view>
  </view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="item" bindtap="onOpen" data-id="{{item.id}}">
      <view class="item-main">
        <view class="item-title">{{item.title}}</view>
        <view wx:if="{{item.subtitle}}" class="item-sub">{{item.subtitle}}</view>
        <view wx:if="{{item.tags.length}}" class="tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
        </view>
      </view>
      <view class="item-side">
        <view wx:if="{{item.questionCount}}" class="q-badge">{{item.questionCount}} 题</view>
        <view class="arrow">›</view>
      </view>
    </view>
  </view>

  <view class="footer">内容持续更新 · 数据与页面分离，便于按学科补充</view>
</view>
