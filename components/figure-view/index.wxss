.fig {
  margin: 16rpx 0 20rpx;
}

.fig-title {
  font-size: 26rpx;
  color: #2a3342;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.fig-box {
  position: relative;
  width: 100%;
  background: #ffffff;
  border: 1rpx solid #e6ebf2;
  border-radius: 12rpx;
  overflow: hidden;
}

.fig-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.fig-cap {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7a8494;
}

.fig-alt {
  padding: 20rpx 24rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5b6676;
}
