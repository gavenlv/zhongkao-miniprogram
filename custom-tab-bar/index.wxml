<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view 
    wx:for="{{list}}" 
    wx:key="pagePath" 
    class="tab-bar-item {{selected === index ? 'selected' : ''}}" 
    data-path="{{item.pagePath}}" 
    data-index="{{index}}" 
    bindtap="switchTab"
  >
    <view class="tab-icon tab-icon-{{item.iconType}} {{selected === index ? 'active' : ''}}"></view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
