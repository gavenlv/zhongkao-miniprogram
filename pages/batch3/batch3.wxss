.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  color: #fff;
  padding: 40rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.batch-info {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.info-content {
  background: #f6ffed;
  border-radius: 8rpx;
  padding: 16rpx;
}

.info-item {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
}

.menu-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.menu-content {
  flex: 1;
}

.menu-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.menu-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.menu-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.tips-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.tips-list {
  background: #fffbe6;
  border-radius: 8rpx;
  padding: 16rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
}
