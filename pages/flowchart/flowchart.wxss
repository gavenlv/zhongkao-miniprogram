.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.header-banner {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.banner-text {
  font-size: 28rpx;
  font-weight: 600;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #1890ff;
  color: #fff;
  font-weight: 600;
}

.content {
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.flowchart {
  padding: 0 16rpx;
}

.flow-step {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border-left: 6rpx solid #d9d9d9;
  transition: all 0.3s;
}

.flow-step.active {
  border-left-color: #1890ff;
  background: #e6f7ff;
}

.flow-step.info {
  border-left-color: #1890ff;
  background: #e6f7ff;
}

.flow-step.warning {
  border-left-color: #faad14;
  background: #fffbe6;
}

.flow-step.success {
  border-left-color: #52c41a;
  background: #f6ffed;
}

.flow-step.danger {
  border-left-color: #ff4d4f;
  background: #fff2f0;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #1890ff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.flow-step.warning .step-number {
  background: #faad14;
}

.flow-step.success .step-number {
  background: #52c41a;
}

.flow-step.danger .step-number {
  background: #ff4d4f;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.flow-arrow {
  text-align: center;
  color: #1890ff;
  font-size: 32rpx;
  padding: 12rpx 0;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.btn-primary {
  background: #1890ff;
  color: #fff;
}

.btn-default {
  background: #f5f5f5;
  color: #666;
}

.gradient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gradient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.gradient-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.gradient-score {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.rule-icon {
  font-size: 32rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.example-box {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.example-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 16rpx;
}

.example-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-icon {
  font-size: 32rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.data-note {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8e8e8;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
