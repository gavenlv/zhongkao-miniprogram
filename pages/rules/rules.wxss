.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  padding: 40rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.menu-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.gradient-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.gradient-list {
  background: #fafafa;
  border-radius: 8rpx;
  overflow: hidden;
}

.gradient-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.gradient-item:last-child {
  border-bottom: none;
}

.gradient-item.last {
  background: #e6f7ff;
}

.gradient-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.gradient-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
}

.gradient-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  background: #52c41a;
  color: #fff;
  font-size: 20rpx;
  border-radius: 4rpx;
}

.gradient-info {
  padding-left: 12rpx;
}

.info-row {
  display: flex;
  padding: 6rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: #666;
  width: 140rpx;
}

.info-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.info-value.desc {
  color: #666;
}

.rule-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.rule-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.rule-list {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.rule-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #1890ff;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 26rpx;
  color: #333;
  line-height: 40rpx;
}
