.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.menu-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 26rpx;
  color: #8c8c8c;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.item-left {
  margin-right: 20rpx;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-flow {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.icon-flow::before {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
}

.icon-flow::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 16rpx solid #fff;
  transform: translateY(8rpx);
}

.icon-case {
  background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);
}

.icon-case::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 44rpx;
  border: 4rpx solid #fff;
  border-radius: 4rpx;
}

.icon-case::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 4rpx;
  background: #fff;
  transform: translateY(-8rpx);
}

.item-content {
  flex: 1;
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #262626;
  margin-right: 12rpx;
}

.item-tag {
  font-size: 22rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.item-tag.tag-new {
  color: #fff;
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
}

.item-desc {
  font-size: 26rpx;
  color: #8c8c8c;
  line-height: 1.5;
}

.item-arrow {
  margin-left: 16rpx;
}

.arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #bfbfbf;
  border-right: 4rpx solid #bfbfbf;
  transform: rotate(45deg);
}

.gradient-card, .rule-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  position: relative;
}

.icon-gradient {
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
}

.icon-gradient::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
}

.icon-rule {
  background: linear-gradient(135deg, #13c2c2 0%, #08979c 100%);
}

.icon-rule::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 28rpx;
  height: 4rpx;
  background: #fff;
  box-shadow: 0 -10rpx 0 #fff, 0 10rpx 0 #fff;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
}

.gradient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gradient-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 6rpx solid #1890ff;
}

.gradient-item.last {
  border-left-color: #ff4d4f;
}

.gradient-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.gradient-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #262626;
  margin-right: 12rpx;
}

.gradient-badge {
  font-size: 22rpx;
  color: #ff4d4f;
  background: #fff1f0;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.gradient-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
}

.info-label {
  font-size: 24rpx;
  color: #8c8c8c;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #262626;
  flex: 1;
}

.info-value.desc {
  color: #595959;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
}

.rule-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 28rpx;
  color: #262626;
  line-height: 40rpx;
}

.icon-volunteer {
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
}

.icon-volunteer::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 4rpx;
  background: #fff;
}

.icon-volunteer::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 32rpx;
  background: #fff;
}

.icon-table {
  background: linear-gradient(135deg, #13c2c2 0%, #08979c 100%);
}

.icon-table::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 24rpx;
  border: 4rpx solid #fff;
  border-radius: 4rpx;
}

.icon-table::after {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 4rpx;
  background: #fff;
  transform: translateY(8rpx);
}

.explain-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.explain-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.explain-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.explain-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
}

.explain-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.explain-item {
  display: flex;
  align-items: flex-start;
}

.explain-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.explain-text {
  font-size: 28rpx;
  color: #595959;
  line-height: 40rpx;
}

.explain-text .highlight {
  color: #722ed1;
  font-weight: bold;
}

.rule-explain-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rule-explain-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.rule-explain-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.rule-explain-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
}

.rule-section {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.rule-section:last-child {
  margin-bottom: 0;
}

.rule-emoji {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-content {
  flex: 1;
}

.rule-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #722ed1;
  margin-bottom: 8rpx;
}

.rule-desc {
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
}
