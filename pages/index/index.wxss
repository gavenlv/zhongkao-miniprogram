.portal {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: #f4f6fa;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #172b4d 0%, #234a8c 60%, #2f66d6 100%);
  border-radius: 24rpx;
  padding: 40rpx 34rpx 32rpx;
  color: #fff;
  box-shadow: 0 14rpx 30rpx rgba(23, 43, 77, 0.22);
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.68);
}

.hero-title {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.82);
}

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 18rpx 0;
}

.hs {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hs-n {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hs-l {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hs-line {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.16);
}

.section-label {
  margin: 30rpx 8rpx 16rpx;
  font-size: 25rpx;
  color: #8a93a4;
}

.module-card {
  position: relative;
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx 28rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(25, 40, 70, 0.06);
  overflow: hidden;
}

.module-card:active {
  transform: scale(0.985);
}

.module-card::before {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  opacity: 0.1;
}

.theme-blue::before {
  background: #2f66d6;
}

.theme-purple::before {
  background: #7355cf;
}

.theme-orange::before {
  background: #e07b1f;
}

.mc-top {
  display: flex;
  align-items: center;
}

.mc-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  background: #f3f6fc;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.theme-blue .mc-icon {
  background: #eaf1fd;
}

.theme-purple .mc-icon {
  background: #f1edfd;
}

.theme-orange .mc-icon {
  background: #fdf2e7;
}

.mc-head {
  flex: 1;
  min-width: 0;
}

.mc-title-row {
  display: flex;
  align-items: center;
}

.mc-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2733;
}

.mc-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #2f66d6;
  background: #eaf1fd;
  border-radius: 6rpx;
  padding: 3rpx 10rpx;
}

.theme-purple .mc-tag {
  color: #7355cf;
  background: #f1edfd;
}

.theme-orange .mc-tag {
  color: #c46c14;
  background: #fdf2e7;
}

.mc-stat {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a93a4;
}

.mc-arrow {
  font-size: 42rpx;
  color: #c3c9d4;
  line-height: 1;
  margin-left: 12rpx;
}

.mc-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #5b6475;
}

.mc-line {
  height: 1rpx;
  background: #f0f2f6;
  margin: 20rpx 0 14rpx;
}

.mc-foot {
  font-size: 23rpx;
  color: #2f66d6;
  text-align: right;
}

.theme-purple .mc-foot {
  color: #7355cf;
}

.theme-orange .mc-foot {
  color: #c46c14;
}

.tips-card {
  margin-top: 10rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(25, 40, 70, 0.05);
}

.tips-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2733;
  margin-bottom: 16rpx;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.tip-row:last-child {
  margin-bottom: 0;
}

.tip-icon {
  color: #2f66d6;
  font-size: 26rpx;
  margin-right: 12rpx;
  line-height: 1.7;
}

.tip-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.75;
  color: #5b6475;
}

.footer {
  margin-top: 34rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #9aa3b3;
}

.footer-version {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #b3bac7;
}
