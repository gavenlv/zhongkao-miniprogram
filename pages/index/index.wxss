.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.quick-nav {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.quick-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 20rpx;
}

.quick-grid {
  display: flex;
  justify-content: space-around;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  transition: all 0.3s;
}

.quick-item:active {
  transform: scale(0.95);
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  position: relative;
}

.icon-rules {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.icon-rules::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 4rpx;
  background: #fff;
  box-shadow: 0 -10rpx 0 #fff, 0 10rpx 0 #fff;
}

.icon-simulate {
  background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);
}

.icon-simulate::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #fff;
  border-radius: 4rpx;
}

.icon-history {
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
}

.icon-history::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
}

.quick-text {
  font-size: 26rpx;
  color: #262626;
}

.menu-section, .news-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 26rpx;
  color: #8c8c8c;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  position: relative;
}

.icon-rules {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.icon-rules::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 4rpx;
  background: #fff;
  box-shadow: 0 -8rpx 0 #fff, 0 8rpx 0 #fff;
}

.icon-simulate {
  background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);
}

.icon-simulate::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #fff;
  border-radius: 4rpx;
}

.icon-history {
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
}

.icon-history::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
}

.card-info {
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 6rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #8c8c8c;
}

.card-arrow {
  margin-left: 12rpx;
}

.arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #bfbfbf;
  border-right: 4rpx solid #bfbfbf;
  transform: rotate(45deg);
}

.sub-menu-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sub-menu-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #fafafa;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.sub-menu-item:active {
  background: #f0f0f0;
}

.sub-dot {
  width: 8rpx;
  height: 8rpx;
  background: #1890ff;
  border-radius: 50%;
  margin-right: 12rpx;
}

.sub-text {
  flex: 1;
  font-size: 28rpx;
  color: #262626;
}

.sub-arrow {
  font-size: 32rpx;
  color: #bfbfbf;
}

.link-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.link-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.link-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.link-left {
  margin-right: 20rpx;
}

.link-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-official {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
}

.icon-official::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 2rpx;
  box-shadow: 0 -12rpx 0 #fff, 0 12rpx 0 #fff;
}

.icon-education {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.icon-education::before {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 24rpx solid #fff;
  transform: translateY(-6rpx);
}

.icon-education::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 16rpx;
  background: #fff;
  transform: translateY(10rpx);
}

.icon-province {
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
}

.icon-province::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
}

.icon-province::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 50%;
}

.link-content {
  flex: 1;
}

.link-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 8rpx;
}

.link-desc {
  font-size: 24rpx;
  color: #8c8c8c;
}

.link-arrow {
  margin-left: 16rpx;
}

.external-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.external-icon::before {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #bfbfbf;
  border-radius: 4rpx;
  top: 6rpx;
  left: 0;
}

.external-icon::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 3rpx;
  background: #bfbfbf;
  transform: rotate(45deg);
  top: 14rpx;
  left: 10rpx;
}

.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-bottom: 8rpx;
}

.footer-link {
  font-size: 24rpx;
  color: #1890ff;
}
