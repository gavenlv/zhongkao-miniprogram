<view class="portal">
  <view class="hero">
    <view class="hero-kicker">一站式学习与升学助手</view>
    <view class="hero-title">初中 · 高中 · 中考</view>
    <view class="hero-desc">分学科知识学习与广州中考志愿模拟，内容按学科独立维护，持续更新</view>
    <view class="hero-stats">
      <view class="hs">
        <text class="hs-n">{{stats.junior}}</text>
        <text class="hs-l">初中学科</text>
      </view>
      <view class="hs-line"></view>
      <view class="hs">
        <text class="hs-n">{{stats.senior}}</text>
        <text class="hs-l">高中学科</text>
      </view>
      <view class="hs-line"></view>
      <view class="hs">
        <text class="hs-n">{{stats.juniorReady}}</text>
        <text class="hs-l">学习模块</text>
      </view>
    </view>
  </view>

  <view class="section-label">选择入口</view>

  <view
    wx:for="{{modules}}"
    wx:key="id"
    class="module-card theme-{{item.theme}}"
    bindtap="onEnter"
    data-id="{{item.id}}"
  >
    <view class="mc-top">
      <view class="mc-icon">{{item.icon}}</view>
      <view class="mc-head">
        <view class="mc-title-row">
          <text class="mc-title">{{item.title}}</text>
          <text class="mc-tag">{{item.tag}}</text>
        </view>
        <view class="mc-stat">{{item.stat}}</view>
      </view>
      <view class="mc-arrow">›</view>
    </view>
    <view class="mc-desc">{{item.desc}}</view>
    <view class="mc-line"></view>
    <view class="mc-foot">点击进入 →</view>
  </view>

  <view class="tips-card">
    <view class="tips-title">使用指引</view>
    <view wx:for="{{tips}}" wx:key="icon" class="tip-row">
      <text class="tip-icon">{{item.icon}}</text>
      <text class="tip-text">{{item.text}}</text>
    </view>
  </view>

  <view class="footer">
    <view class="footer-text">内容仅供学习参考，招生录取信息以官方发布为准</view>
    <view class="footer-version">v{{version}}</view>
  </view>
</view>
