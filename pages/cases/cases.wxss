.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  padding: 40rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.type-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
}

.type-tab.active {
  background: #1890ff;
  color: #fff;
  font-weight: bold;
}

.case-list {
  padding-bottom: 20rpx;
}

.case-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.case-card.success {
  border-left: 6rpx solid #52c41a;
}

.case-card.fail {
  border-left: 6rpx solid #f5222d;
}

.case-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.case-type {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  font-weight: bold;
}

.case-type.success {
  background: #f6ffed;
  color: #52c41a;
}

.case-type.fail {
  background: #fff2f0;
  color: #f5222d;
}

.case-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.case-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.case-info {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.case-key {
  background: #f0f5ff;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.key-label {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: bold;
}

.key-text {
  font-size: 24rpx;
  color: #333;
}

.case-arrow {
  text-align: center;
  font-size: 24rpx;
  color: #1890ff;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
}

.modal-body {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #1890ff;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.grid-item {
  width: 50%;
  padding: 8rpx 0;
}

.grid-label {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.grid-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.volunteer-detail-list {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.volunteer-detail-item {
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e8e8e8;
}

.volunteer-detail-item:last-child {
  margin-bottom: 0;
}

.volunteer-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 12rpx;
}

.volunteer-detail-header.success {
  border-left: 4rpx solid #52c41a;
  padding-left: 12rpx;
}

.volunteer-detail-header.failed, .volunteer-detail-header.fail {
  border-left: 4rpx solid #f5222d;
  padding-left: 12rpx;
}

.volunteer-detail-header.info {
  border-left: 4rpx solid #1890ff;
  padding-left: 12rpx;
}

.volunteer-detail-order {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.volunteer-detail-status {
  font-size: 24rpx;
}

.volunteer-detail-school {
  padding: 8rpx 0;
  margin-bottom: 12rpx;
}

.school-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1890ff;
}

.volunteer-detail-info {
  background: #f5f5f5;
  border-radius: 6rpx;
  padding: 12rpx;
  margin-bottom: 12rpx;
}

.info-line {
  display: flex;
  padding: 4rpx 0;
}

.info-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.info-key {
  font-size: 22rpx;
  color: #666;
  width: 180rpx;
}

.info-val {
  font-size: 22rpx;
  color: #333;
  font-weight: bold;
}

.volunteer-detail-reason {
  background: #fffbe6;
  border-radius: 6rpx;
  padding: 12rpx;
}

.reason-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #ad8b00;
  margin-bottom: 8rpx;
}

.reason-text {
  font-size: 22rpx;
  color: #333;
  line-height: 1.6;
}

.result-box {
  padding: 24rpx;
  border-radius: 8rpx;
  text-align: center;
}

.result-box.success {
  background: #f6ffed;
}

.result-box.fail {
  background: #fff2f0;
}

.result-status {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.result-school, .result-volunteer {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.analysis-box {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.analysis-line {
  font-size: 26rpx;
  color: #333;
  line-height: 2;
  padding: 8rpx 0;
  border-bottom: 1rpx dashed #e8e8e8;
}

.analysis-line:last-child {
  border-bottom: none;
}

.key-point-box {
  background: #fffbe6;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #ad8b00;
  line-height: 1.6;
}
