.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding-bottom: 50rpx;
}

.head {
  padding: 36rpx 30rpx 30rpx;
  color: #fff;
}

.head-top {
  display: flex;
  align-items: center;
}

.head-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 18rpx;
}

.head-name {
  font-size: 42rpx;
  font-weight: 700;
}

.head-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.82);
}

.head-desc {
  margin-top: 20rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
}

.head-stat {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
}

.section-label {
  margin: 26rpx 28rpx 14rpx;
  font-size: 25rpx;
  color: #8a93a4;
}

.module-list {
  padding: 0 24rpx;
}

.module {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 5rpx 14rpx rgba(25, 40, 70, 0.04);
}

.module:active {
  background: #fbfcfe;
}

.module.pending {
  opacity: 0.72;
}

.module-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #f2f5fb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.module-main {
  flex: 1;
  min-width: 0;
}

.module-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.module-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2733;
  line-height: 1.4;
}

.badge {
  margin-left: 10rpx;
  font-size: 19rpx;
  color: #98a1b2;
  background: #f1f3f7;
  border-radius: 5rpx;
  padding: 2rpx 8rpx;
}

.badge.ok {
  color: #1a9a6c;
  background: #eaf7f1;
}

.module-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #79849a;
}

.module-arrow {
  font-size: 36rpx;
  color: #c2c9d4;
  margin-left: 12rpx;
}

.tip-card {
  margin: 18rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tip-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2733;
  margin-bottom: 12rpx;
}

.tip-row {
  font-size: 24rpx;
  line-height: 1.75;
  color: #5b6475;
  margin-bottom: 8rpx;
}
