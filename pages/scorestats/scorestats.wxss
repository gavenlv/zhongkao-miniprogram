.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.fixed-header {
  flex-shrink: 0;
}

.header-banner {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.banner-text {
  font-size: 26rpx;
  font-weight: 500;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
}

.tab.active {
  background: #1890ff;
  color: #fff;
  font-weight: bold;
}

.calculator {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.calc-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.calc-input {
  display: flex;
  gap: 16rpx;
}

.calc-input input {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.calc-btn {
  padding: 0 32rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.rank-result {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

.rank-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #bae7ff;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-label {
  font-size: 28rpx;
  color: #666;
}

.rank-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.rank-value.score {
  color: #1890ff;
}

.rank-value.percent {
  color: #52c41a;
}

.interpolation-info {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f0f5ff;
  border-radius: 8rpx;
  border: 1rpx solid #adc6ff;
}

.interpolation-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 12rpx;
}

.interpolation-detail {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.interpolation-detail:last-child {
  margin-bottom: 0;
}

.exact-info {
  margin-top: 16rpx;
  text-align: center;
}

.exact-badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.estimate-btn {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.table-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx 12rpx 0 0;
}

.table-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1890ff;
}

.table-count {
  font-size: 24rpx;
  color: #999;
}

.table-header {
  display: flex;
  padding: 20rpx;
  background: #fafafa;
  font-weight: bold;
  font-size: 28rpx;
  color: #333;
}

.table-body {
  flex: 1;
  background: #fff;
  min-height: 300rpx;
}

.table-row {
  display: flex;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  background: #fff;
}

.table-row.highlight {
  background: #e6f7ff;
}

.table-row.highlight text {
  color: #1890ff;
  font-weight: bold;
}

.col-score {
  width: 35%;
}

.col-count {
  width: 35%;
  text-align: center;
}

.col-percent {
  width: 30%;
  text-align: right;
  color: #52c41a;
}

.tips {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #ad8b00;
  flex-shrink: 0;
}
