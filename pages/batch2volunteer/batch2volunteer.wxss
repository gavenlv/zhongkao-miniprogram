.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  padding: 40rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.info-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.info-content {
  padding-left: 12rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

.form-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-value.placeholder {
  color: #999;
}

.form-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

.volunteer-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.volunteer-header {
  margin-bottom: 16rpx;
}

.volunteer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.volunteer-list {
  background: #fafafa;
  border-radius: 8rpx;
  overflow: hidden;
}

.volunteer-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.volunteer-item:last-child {
  border-bottom: none;
}

.volunteer-order {
  width: 120rpx;
  font-size: 26rpx;
  color: #1890ff;
  font-weight: bold;
}

.volunteer-school {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 4rpx;
  border: 1rpx solid #d9d9d9;
}

.volunteer-school.empty {
  color: #999;
}

.volunteer-clear {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #f5222d;
  margin-left: 12rpx;
}

.competitor-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.competitor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.competitor-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.competitor-add {
  font-size: 24rpx;
  color: #1890ff;
}

.competitor-info {
  font-size: 24rpx;
  color: #666;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  flex: 1;
  background: #1890ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.btn-secondary {
  flex: 1;
  background: #fff;
  color: #666;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d9d9d9;
}

.result-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.result-header {
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.result-content {
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.result-content.success {
  background: #f6ffed;
}

.result-content.fail {
  background: #fff2f0;
}

.result-status {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.result-school, .result-type, .result-quota {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.result-error {
  font-size: 26rpx;
  color: #f5222d;
}

.process-log {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.log-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.log-item {
  padding: 12rpx;
  border-left: 4rpx solid #d9d9d9;
  margin-bottom: 12rpx;
  background: #fff;
}

.log-item.success {
  border-left-color: #52c41a;
  background: #f6ffed;
}

.log-item.fail, .log-item.failed {
  border-left-color: #f5222d;
  background: #fff1f0;
}

.log-item.info {
  border-left-color: #1890ff;
  background: #e6f7ff;
}

.log-item.skip {
  border-left-color: #d9d9d9;
  background: #fafafa;
  opacity: 0.7;
}

.log-step {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.log-message {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.log-details {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999;
}

.result-gradient {
  font-size: 26rpx;
  color: #1890ff;
  margin-top: 8rpx;
}

.result-volunteer {
  font-size: 26rpx;
  color: #722ed1;
  margin-top: 8rpx;
}

.school-picker-modal, .junior-school-modal, .competitor-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
}

.modal-search {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-input {
  width: 100%;
  height: 64rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.modal-list {
  flex: 1;
  max-height: 50vh;
}

.school-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.school-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.school-info {
  font-size: 24rpx;
  color: #999;
}

.school-info text {
  margin-right: 20rpx;
}

.school-control-line {
  font-size: 22rpx;
  color: #faad14;
  margin-top: 4rpx;
}

.junior-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333;
}

.modal-body {
  flex: 1;
  padding: 24rpx;
  max-height: 50vh;
}

.competitor-list {
  margin-bottom: 20rpx;
}

.competitor-item {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.competitor-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.competitor-row:last-child {
  margin-bottom: 0;
}

.competitor-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.competitor-remove {
  font-size: 24rpx;
  color: #f5222d;
  margin-left: auto;
}

.competitor-input {
  flex: 1;
  height: 48rpx;
  padding: 0 12rpx;
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 4rpx;
  font-size: 26rpx;
}

.competitor-picker {
  flex: 1;
  padding: 8rpx 12rpx;
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #333;
}

.btn-add-competitor {
  width: 100%;
  background: #f0f5ff;
  color: #1890ff;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.guide-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #1890ff;
}

.guide-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 16rpx;
}

.guide-content {
  padding-left: 12rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.guide-item:last-child {
  margin-bottom: 0;
}

.guide-number {
  width: 40rpx;
  height: 40rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.guide-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  padding-top: 6rpx;
}

.quota-info-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.quota-header {
  margin-bottom: 16rpx;
}

.quota-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.quota-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quota-item {
  background: #f0f5ff;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #adc6ff;
}

.quota-school {
  font-size: 24rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 4rpx;
}

.quota-count {
  font-size: 22rpx;
  color: #666;
}

.quota-control-line {
  font-size: 22rpx;
  color: #faad14;
  margin-top: 4rpx;
}

.quota-tip {
  margin-top: 16rpx;
  padding: 12rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #ad8b00;
  line-height: 1.5;
}

.volunteer-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.volunteer-quota {
  font-size: 22rpx;
  color: #52c41a;
  margin-top: 4rpx;
}

.volunteer-warning {
  font-size: 22rpx;
  color: #faad14;
  margin-top: 4rpx;
}

.volunteer-tip {
  margin-top: 16rpx;
  padding: 12rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #ad8b00;
}

.competitor-guide {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding: 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.competitor-school-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.competitor-school-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
}

.competitor-school-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.competitor-school-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
}

.competitor-school-quota {
  font-size: 24rpx;
  color: #52c41a;
}

.competitor-input-area {
  margin-top: 12rpx;
}

.competitor-input-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.competitor-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.competitor-input-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.school-item.no-quota {
  opacity: 0.5;
}

.no-quota-text {
  color: #faad14;
}

.disclaimer {
  margin: 30rpx 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fffbe6 100%);
  border-radius: 12rpx;
  border-left: 6rpx solid #faad14;
  display: flex;
  align-items: flex-start;
}

.disclaimer-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.disclaimer-content {
  flex: 1;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #d48806;
  margin-bottom: 8rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.5;
}
