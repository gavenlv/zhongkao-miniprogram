.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.8;
}

.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.sort-bar {
  display: flex;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}

.sort-item.active {
  color: #1890ff;
  font-weight: bold;
}

.school-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.school-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.school-item:last-child {
  border-bottom: none;
}

.school-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.school-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.school-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.school-type {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.school-type.public {
  background: #e6f7ff;
  color: #1890ff;
}

.school-type.private {
  background: #fff7e6;
  color: #fa8c16;
}

.trend-icon {
  font-size: 32rpx;
}

.stats-row {
  display: flex;
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
}

.stat-value.score {
  color: #1890ff;
}

.stat-value.rank {
  color: #52c41a;
}

.stat-value.percent {
  color: #fa8c16;
}

.change-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.change-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  border-left: 4rpx solid #d9d9d9;
}

.change-item.up {
  border-left-color: #52c41a;
  background: #f6ffed;
}

.change-item.down {
  border-left-color: #f5222d;
  background: #fff2f0;
}

.change-item.stable {
  border-left-color: #faad14;
  background: #fffbe6;
}

.change-label {
  font-size: 22rpx;
  color: #666;
}

.change-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-top: 4rpx;
}

.change-item.up .change-value {
  color: #52c41a;
}

.change-item.down .change-value {
  color: #f5222d;
}

.year-scores {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.year-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  min-width: 120rpx;
}

.year-label {
  font-size: 22rpx;
  color: #999;
}

.year-score {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.year-rank {
  font-size: 22rpx;
  color: #52c41a;
}

.year-percent {
  font-size: 20rpx;
  color: #fa8c16;
}

.detail-section {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

.detail-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 12rpx;
}

.change-detail {
  padding: 12rpx;
  background: #fff;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.change-detail:last-child {
  margin-bottom: 0;
}

.change-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #333;
}

.change-trend {
  font-size: 22rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.change-trend.up {
  background: #f6ffed;
  color: #52c41a;
}

.change-trend.down {
  background: #fff2f0;
  color: #f5222d;
}

.change-trend.stable {
  background: #fffbe6;
  color: #faad14;
}

.change-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 22rpx;
  color: #666;
}

.change-stats text {
  padding: 4rpx 8rpx;
  background: #f5f5f5;
  border-radius: 4rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.tips {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fffbe6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #ad8b00;
}

.tips text {
  display: block;
  margin-bottom: 8rpx;
}

.tips text:last-child {
  margin-bottom: 0;
}

.disclaimer {
  margin: 30rpx 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fffbe6 100%);
  border-radius: 12rpx;
  border-left: 6rpx solid #faad14;
  display: flex;
  align-items: flex-start;
}

.disclaimer-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.disclaimer-content {
  flex: 1;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #d48806;
  margin-bottom: 8rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.5;
}