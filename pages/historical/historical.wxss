.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.picker-btn {
  padding: 12rpx 24rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
  color: #1890ff;
  font-size: 28rpx;
}

.switch-label {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.sort-bar {
  display: flex;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}

.sort-item.active {
  color: #1890ff;
  font-weight: bold;
}

.school-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.school-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.school-item:last-child {
  border-bottom: none;
}

.school-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.school-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.school-type {
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.school-type.public {
  background: #e6f7ff;
  color: #1890ff;
}

.school-type.private {
  background: #fff7e6;
  color: #fa8c16;
}

.school-info {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
}

.info-row {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}

.info-item .label {
  font-size: 24rpx;
  color: #999;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  margin-top: 4rpx;
}

.info-item .value.score {
  color: #1890ff;
  font-weight: bold;
}

.no-data {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.disclaimer {
  margin: 30rpx 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fffbe6 100%);
  border-radius: 12rpx;
  border-left: 6rpx solid #faad14;
  display: flex;
  align-items: flex-start;
}

.disclaimer-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.disclaimer-content {
  flex: 1;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #d48806;
  margin-bottom: 8rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.5;
}