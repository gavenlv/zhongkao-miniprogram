.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: #f4f6fa;
  box-sizing: border-box;
}

.banner {
  background: linear-gradient(135deg, #164a7a 0%, #1f6fae 55%, #2f8fbf 100%);
  border-radius: 22rpx;
  padding: 34rpx 30rpx;
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(22, 74, 122, 0.2);
}

.banner-kicker {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}

.banner-title {
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.banner-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
}

.banner-meta {
  margin-top: 22rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

.dot {
  margin: 0 10rpx;
}

.section-label {
  margin: 30rpx 8rpx 16rpx;
  font-size: 25rpx;
  color: #8a93a4;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.subject {
  width: calc(50% - 9rpx);
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(25, 40, 70, 0.05);
}

.subject:active {
  transform: scale(0.98);
}

.subject-top {
  display: flex;
  align-items: center;
}

.subject-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #fff;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.subject-name-wrap {
  min-width: 0;
}

.subject-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1f2733;
  line-height: 1.3;
}

.subject-score {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a93a4;
}

.subject-desc {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #6b7486;
  height: 74rpx;
  overflow: hidden;
}

.subject-foot {
  margin-top: 14rpx;
}

.subject-count {
  font-size: 21rpx;
  color: #9aa3b3;
}

.subject-count.on {
  color: #1a9a6c;
}

.progress {
  margin-top: 8rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #eef1f6;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 8rpx;
}

.note-card {
  margin-top: 12rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 26rpx 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(25, 40, 70, 0.05);
}

.note-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2733;
  margin-bottom: 14rpx;
}

.note-row {
  font-size: 24rpx;
  line-height: 1.75;
  color: #5b6475;
  margin-bottom: 10rpx;
}

.footer {
  margin-top: 28rpx;
  text-align: center;
  font-size: 21rpx;
  color: #9aa3b3;
}
