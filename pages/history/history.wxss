.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.menu-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 26rpx;
  color: #8c8c8c;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.item-left {
  margin-right: 20rpx;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-historical {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}

.icon-historical::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 4rpx;
  background: #fff;
  box-shadow: 0 -12rpx 0 #fff, 0 12rpx 0 #fff;
}

.icon-historical::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 36rpx;
  background: #fff;
  transform: translateX(-8rpx);
}

.icon-scorestats {
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
}

.icon-scorestats::before {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 20rpx solid #fff;
  transform: translateX(-12rpx) translateY(4rpx);
}

.icon-scorestats::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 28rpx solid #fff;
  transform: translateX(12rpx);
}

.icon-ranking {
  background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);
}

.icon-ranking::before {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 4rpx;
  background: #fff;
  transform: rotate(-30deg) translateY(-8rpx);
}

.icon-ranking::after {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 4rpx;
  background: #fff;
  transform: rotate(30deg) translateY(8rpx) translateX(8rpx);
}

.item-content {
  flex: 1;
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #262626;
  margin-right: 12rpx;
}

.item-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.tag-recommend {
  color: #52c41a;
  background: #f6ffed;
}

.tag-useful {
  color: #1890ff;
  background: #e6f7ff;
}

.tag-trend {
  color: #fa8c16;
  background: #fff7e6;
}

.item-desc {
  font-size: 26rpx;
  color: #8c8c8c;
  line-height: 1.5;
}

.item-arrow {
  margin-left: 16rpx;
}

.arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #bfbfbf;
  border-right: 4rpx solid #bfbfbf;
  transform: rotate(45deg);
}

.data-card, .tips-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  position: relative;
}

.icon-data {
  background: linear-gradient(135deg, #13c2c2 0%, #08979c 100%);
}

.icon-data::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #fff;
  border-radius: 4rpx;
}

.icon-tips {
  background: linear-gradient(135deg, #eb2f96 0%, #c41d7f 100%);
}

.icon-tips::before {
  content: '?';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
}

.data-info {
  padding: 16rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-around;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
}

.info-label {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 8rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tips-item {
  display: flex;
  align-items: flex-start;
}

.tips-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 28rpx;
  color: #262626;
  line-height: 40rpx;
}
