.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.2);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.timeline-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.timeline-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 20rpx;
}

.timeline-list {
  position: relative;
  padding-left: 40rpx;
}

.timeline-list::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 2rpx;
  background: #e8e8e8;
}

.timeline-item {
  position: relative;
  padding: 16rpx 0;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1890ff;
  border: 4rpx solid #e6f7ff;
}

.timeline-content {
  display: flex;
  flex-direction: column;
}

.timeline-date {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.timeline-event {
  font-size: 28rpx;
  color: #595959;
}

.gradient-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.gradient-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 20rpx;
}

.gradient-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.gradient-item {
  width: calc(50% - 6rpx);
  padding: 16rpx;
  background: #fafafa;
  border-radius: 8rpx;
  border-left: 6rpx solid #1890ff;
  box-sizing: border-box;
}

.gradient-name {
  font-size: 26rpx;
  color: #262626;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.gradient-score {
  font-size: 24rpx;
  color: #8c8c8c;
}

.rule-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rule-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 20rpx;
}

.rule-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.rule-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.rule-text {
  flex: 1;
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
}

.rule-highlight {
  color: #1890ff;
  font-weight: bold;
}

.batch-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.batch-tab {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #595959;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.batch-tab.active {
  background: #1890ff;
  color: #fff;
}

.batch-section {
  margin-bottom: 24rpx;
}

.batch-header {
  padding: 20rpx 24rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.batch-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.category-list {
  background: #fff;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.category-item {
  padding: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.category-item:last-child {
  border-bottom: none;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.category-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #262626;
  line-height: 1.4;
  margin-right: 12rpx;
}

.category-volunteers {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
  white-space: nowrap;
}

.category-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.content-section {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.section-text {
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
}

.tips-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tips-item {
  display: flex;
  align-items: flex-start;
}

.tips-num {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #fa8c16 0%, #d46b08 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 26rpx;
  color: #595959;
  line-height: 36rpx;
}

.example-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.example-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 20rpx;
}

.example-item {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
  border-left: 6rpx solid #1890ff;
}

.example-item:last-child {
  margin-bottom: 0;
}

.example-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 12rpx;
}

.example-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.example-scenario {
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
  padding: 12rpx;
  background: #fff;
  border-radius: 8rpx;
}

.example-result {
  font-size: 26rpx;
  color: #262626;
  line-height: 1.6;
}

.result-label {
  color: #52c41a;
  font-weight: bold;
}

.disclaimer {
  display: flex;
  padding: 20rpx;
  background: #fffbe6;
  border-radius: 12rpx;
}

.disclaimer-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.disclaimer-content {
  flex: 1;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #d48806;
  margin-bottom: 8rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #874d00;
  line-height: 1.5;
}
